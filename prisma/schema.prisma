datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Topic {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at")
  questions Question[]

  @@map("topics")
}

model Question {
  id           String      @id @default(uuid()) @db.Uuid
  topicId      String      @map("topic_id") @db.Uuid
  topic        Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  question     String      @db.Text
  answer       String      @db.Text
  confidence   String      @default("weak")
  tags         String[]    @default([])
  isFlagged    Boolean     @default(false) @map("is_flagged")
  isImportant  Boolean     @default(false) @map("is_important")
  categoryTag  String?     @map("category_tag")
  notes        String?     @db.Text
  lastReviewed DateTime?   @map("last_reviewed")
  nextReviewAt DateTime?   @map("next_review_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  reviewLogs   ReviewLog[]

  @@map("questions")
}

model ReviewLog {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  rating     String
  reviewedAt DateTime @default(now()) @map("reviewed_at")

  @@index([questionId, reviewedAt])
  @@index([reviewedAt])
  @@map("review_logs")
}

